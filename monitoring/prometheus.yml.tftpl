global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["prometheus:9090"]

  - job_name: swarm-nodes
    file_sd_configs:
      - files: ["/etc/prometheus/targets/nodes.json"]

  - job_name: swarm-containers
    file_sd_configs:
      - files: ["/etc/prometheus/targets/containers.json"]

  - job_name: demo-app
    file_sd_configs:
      - files: ["/etc/prometheus/targets/demo-app.json"]
    metrics_path: /metrics
